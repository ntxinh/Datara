import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Bridge } from "../bridge.slint";

/// SQL editing surface: raw `TextInput` (the styled `TextEdit` doesn't
/// expose byte offsets or font metrics) inside a `ScrollView`, a line-number
/// gutter pinned to its left, a per-token highlight overlay painted on top
/// of the input's own glyphs, and a completion popup at the caret.
///
/// Highlight approach: `TextInput` keeps its `Theme.fg` foreground (caret +
/// selection keep working) and the overlay re-paints `Text` spans at
/// identical monospace cell coordinates from one probe-measured metric.
/// Misregistration shows as doubled glyphs — if the two text paths ever
/// visibly diverge, flip `overlay-enabled` off for the single-color
/// fallback (gutter + status line keep working either way).
export component QueryEditor inherits Rectangle {
    /// Disable to fall back to uncolored editor text.
    in property<bool> overlay-enabled: true;

    /// Ask the input to take keyboard focus (window init, after popup click).
    public function focus-editor() {
        edit.focus();
    }

    // Measured monospace metrics — one probe source feeds the overlay x/y
    // math, the gutter, the popup position and the status-bar column.
    // Invisible items still get geometry.
    w-probe := Text {
        text: "0000000000000000";
        font-family: "JetBrains Mono";
        font-size: Bridge.editor-font-size * 1px;
        visible: false;
    }
    h-probe := Text {
        text: "0\n0";
        font-family: "JetBrains Mono";
        font-size: Bridge.editor-font-size * 1px;
        visible: false;
    }
    property<length> char-w: w-probe.width / 16;
    property<length> line-h: h-probe.height / 2;
    property<int> gutter-digits: Bridge.line-count < 100 ? 2 : Bridge.line-count < 1000 ? 3 : Bridge.line-count < 10000 ? 4 : 5;
    property<length> gutter-w: gutter-digits * char-w + 20px;

    // Caret pixel position in content space (from cursor-position-changed);
    // drives the popup placement.
    property<length> caret-x;
    property<length> caret-y;

    background: Theme.bg;
    clip: true;

    // Gutter — outside the ScrollView, translated by its scroll offset.
    Rectangle {
        x: 0;
        y: 0;
        width: root.gutter-w;
        height: 100%;
        background: Theme.panel;
        clip: true;

        for n in Bridge.line-count: Text {
            x: 0;
            y: n * root.line-h + scroll.content-y;
            width: root.gutter-w - 8px;
            height: root.line-h;
            text: n + 1;
            color: Theme.fg;
            opacity: 0.4;
            font-family: "JetBrains Mono";
            font-size: Bridge.editor-font-size * 1px;
            horizontal-alignment: right;
            vertical-alignment: top;
        }
    }

    scroll := ScrollView {
        x: root.gutter-w;
        y: 0;
        width: parent.width - root.gutter-w;
        height: parent.height;
        mouse-drag-pan-enabled: false;
        content-width: max(self.visible-width, edit.preferred-width + 40px);
        content-height: max(self.visible-height, edit.preferred-height + 40px);

        edit := TextInput {
            x: 0;
            y: 0;
            width: max(scroll.visible-width, self.preferred-width);
            height: max(scroll.visible-height, self.preferred-height);
            single-line: false;
            wrap: no-wrap;
            font-family: "JetBrains Mono";
            font-size: Bridge.editor-font-size * 1px;
            color: Theme.fg;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.fg;
            text <=> Bridge.editor-text;

            edited => {
                Bridge.editor-changed(self.text, self.cursor-position-byte-offset);
            }
            cursor-position-changed(cpos) => {
                Bridge.cursor-changed(
                    self.cursor-position-byte-offset,
                    self.anchor-position-byte-offset,
                    Math.floor(cpos.y / root.line-h) + 1,
                    Math.round(cpos.x / root.char-w) + 1);
                root.caret-x = cpos.x;
                root.caret-y = cpos.y;
            }
            key-pressed(event) => {
                // Popup keys first, then app commands. Both run through
                // Bridge so no key handling lives in the view.
                // Popup keys apply only for unmodified presses — modified
                // keys (Ctrl+Enter, Ctrl+Tab, Ctrl+Shift+…) fall through to
                // Bridge.command so app shortcuts keep working while the
                // popup is open. Shift alone still accepts/navigates.
                if (Bridge.completions.length > 0 && !event.modifiers.control && !event.modifiers.alt) {
                    if (event.text == Key.Tab || event.text == Key.Return) {
                        Bridge.completion-action("accept");
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        Bridge.completion-action("escape");
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        Bridge.completion-action("up");
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        Bridge.completion-action("down");
                        return accept;
                    }
                }
                // Plain Tab inserts `[editor] tab_size` spaces via Rust
                // (TextInput has no insert API); Ctrl+Tab stays a command.
                if (event.text == Key.Tab && !event.modifiers.control && !event.modifiers.alt) {
                    Bridge.insert-tab();
                    return accept;
                }
                if (Bridge.command(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt)) {
                    return accept;
                }
                reject
            }
        }

        // Colored overlay — declared after `edit` so it paints on top of
        for span in Bridge.highlight-spans: Text {
            visible: root.overlay-enabled;
            x: span.col * root.char-w;
            y: span.line * root.line-h;
            height: root.line-h;
            text: span.text;
            color: span.color;
            font-family: "JetBrains Mono";
            font-size: Bridge.editor-font-size * 1px;
            vertical-alignment: top;
        }

        // Completion popup — content space, so it rides the scroll.
        if Bridge.completions.length > 0: Rectangle {
            x: min(max(0px, root.caret-x), max(0px, scroll.content-width - 200px));
            y: root.caret-y + root.line-h;
            width: 200px;
            height: min(Bridge.completions.length, 8) * 24px + 8px;
            background: Theme.panel;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 4px;
            clip: true;

            ListView {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                for item[i] in Bridge.completions: Rectangle {
                    height: 24px;
                    background: i == Bridge.completion-index ? Theme.accent.with-alpha(0.25) : transparent;
                    Text {
                        x: 8px;
                        text: item;
                        color: Theme.fg;
                        font-family: "JetBrains Mono";
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            Bridge.completion-index = i;
                            Bridge.completion-action("accept");
                            root.focus-editor();
                        }
                    }
                }
            }
        }
    }

    // Programmatic caret placement (completion apply, tab switch):
    // `Bridge.set-cursor` packs offset<<8 | nonce so every set re-fires.
    property<int> cursor-jump: Bridge.set-cursor;
    changed cursor-jump => {
        edit.set-selection-offsets(Math.floor(Bridge.set-cursor / 256), Math.floor(Bridge.set-cursor / 256));
    }
}
