import { Button, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Bridge } from "../bridge.slint";

/// Connection list + status line. Later phases add schema tree here.
export component Sidebar inherits Rectangle {
    /// Toolbar button pressed — the window opens the connection dialog.
    callback new-connection-requested();

    width: 260px;
    background: Theme.panel;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 4px;
            Text {
                text: "Connections";
                color: Theme.fg;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { }
            Button {
                text: "+ New";
                clicked => {
                    root.new-connection-requested();
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        ListView {
            vertical-stretch: 1;
            for conn in Bridge.connections: Rectangle {
                height: 48px;
                HorizontalLayout {
                    padding: 4px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: conn.name;
                            color: Theme.fg;
                            overflow: elide;
                        }
                        Text {
                            text: conn.host;
                            color: Theme.fg;
                            opacity: 0.6;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }
                    Rectangle { }
                    Button {
                        text: "Connect";
                        clicked => {
                            Bridge.connect-profile(conn.id);
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        Text {
            text: Bridge.status;
            color: Theme.fg;
            opacity: 0.7;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
