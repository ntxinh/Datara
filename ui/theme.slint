// Catppuccin-ish palette (Mocha dark / Latte light).
// `dark` is driven by `[appearance] theme` in config.toml — set once at
// startup from Rust; "system" resolves to dark until OS probing lands.
export global Theme {
    in-out property<bool> dark: true;
    out property<color> bg: dark ? #1e1e2e : #fafafa;
    out property<color> fg: dark ? #cdd6f4 : #4c4f69;
    out property<color> panel: dark ? #181825 : #e6e9ef;
    out property<color> border: dark ? #313244 : #ccd0da;
    out property<color> accent: #89b4fa;
}
