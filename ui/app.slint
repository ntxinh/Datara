import { Theme } from "theme.slint";
import { Sidebar } from "components/sidebar.slint";
import { TabStrip } from "components/tabs.slint";
import { QueryEditor } from "editor/query_editor.slint";
import { Button } from "std-widgets.slint";
import { ConnDialog } from "dialogs/connection.slint";
import { Bridge } from "bridge.slint";

// Re-export so Rust's include_modules! sees the generated types.
export { ConnForm, TreeNode, TabItem, HighlightSpan, Bridge } from "bridge.slint";

export component MainWindow inherits Window {
    title: "Datara";
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Theme.bg;

    property<bool> show-dialog: false;
    /// Sidebar width, dragged by the 4px handle between sidebar and editor.
    property<length> sidebar-width: 260px;

    init => {
        editor.focus-editor();
    }

    // Root command router: Ctrl+* shortcuts that the editor didn't consume
    // (or keys pressed while something else has focus) bubble up here.
    FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            Bridge.command(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) ? accept : reject
        }

        VerticalLayout {
            spacing: 0;

            // Toolbar strip
            Rectangle {
                height: 40px;
                background: Theme.panel;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;

                    Text {
                        text: "Datara";
                        color: Theme.fg;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Run  (Ctrl+Enter)";
                        clicked => {
                            Bridge.command("\n", true, false, false);
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0;

                Rectangle {
                    width: root.sidebar-width;
                    clip: true;
                    Sidebar {
                        width: 100%;
                        height: 100%;
                        new-connection-requested => {
                            root.show-dialog = true;
                        }
                    }
                }

                // 4px drag handle resizing the sidebar.
                Rectangle {
                    width: 4px;
                    background: resize-ta.has-hover || resize-ta.pressed ? Theme.accent : Theme.border;
                    resize-ta := TouchArea {
                        property<length> start-w;
                        moved => {
                            if (self.pressed) {
                                root.sidebar-width = max(160px, min(480px, self.start-w + self.mouse-x - self.pressed-x));
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                self.start-w = root.sidebar-width;
                            }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0;

                    TabStrip { }

                    editor := QueryEditor {
                        vertical-stretch: 2;
                    }

                    Rectangle { height: 1px; background: Theme.border; }

                    // Results placeholder — Phase 5 puts the grid here.
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.panel;
                        Text {
                            x: 10px;
                            y: 6px;
                            text: "Results";
                            color: Theme.fg;
                            opacity: 0.6;
                            font-size: 12px;
                        }
                        Text {
                            x: 10px;
                            y: 26px;
                            text: Bridge.results-text;
                            color: Theme.fg;
                            opacity: 0.8;
                            font-size: 12px;
                            wrap: word-wrap;
                            width: parent.width - 20px;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            // Status bar: status text left, caret position right.
            Rectangle {
                height: 22px;
                background: Theme.panel;

                Text {
                    x: 10px;
                    text: Bridge.status;
                    color: Theme.fg;
                    opacity: 0.7;
                    font-size: 11px;
                    vertical-alignment: center;
                    width: parent.width - 110px;
                    overflow: elide;
                }
                Text {
                    x: parent.width - 100px;
                    width: 90px;
                    text: Bridge.cursor-position;
                    color: Theme.fg;
                    opacity: 0.7;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }

    // Modal overlay — Slint 1.18's fluent style has no Dialog widget, so a
    // dimmed full-window overlay with a centered card plays that role.
    if root.show-dialog: ConnDialog {
        width: 100%;
        height: 100%;
        close-requested => {
            root.show-dialog = false;
        }
    }
}
