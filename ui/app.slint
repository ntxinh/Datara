import { Theme } from "theme.slint";
import { Sidebar } from "components/sidebar.slint";
import { ConnDialog } from "dialogs/connection.slint";

// Re-export so Rust's include_modules! sees the generated types.
export { ConnForm, ConnectionItem, Bridge } from "bridge.slint";

export component MainWindow inherits Window {
    title: "Datara";
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Theme.bg;

    property<bool> show-dialog: false;

    HorizontalLayout {
        Sidebar {
            new-connection-requested => {
                root.show-dialog = true;
            }
        }
        Rectangle {
            background: Theme.bg;
            Text {
                text: "Select a connection to begin";
                color: Theme.fg;
                opacity: 0.5;
            }
        }
    }

    // Modal overlay — Slint 1.18's fluent style has no Dialog widget, so a
    // dimmed full-window overlay with a centered card plays that role.
    if root.show-dialog: ConnDialog {
        width: 100%;
        height: 100%;
        close-requested => {
            root.show-dialog = false;
        }
    }
}
