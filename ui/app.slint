import { Theme } from "theme.slint";
import { Sidebar } from "components/sidebar.slint";
import { TabStrip } from "components/tabs.slint";
import { Palette } from "components/palette.slint";
import { QueryEditor } from "editor/query_editor.slint";
import { Button } from "std-widgets.slint";
import { ConnDialog } from "dialogs/connection.slint";
import { SaveQueryDialog } from "dialogs/save_query.slint";
import { Bridge } from "bridge.slint";
import { ResultGrid } from "grid/result_grid.slint";
import { HistoryPanel } from "pages/history.slint";

// Re-export so Rust's include_modules! sees the generated types.
export { ConnForm, TreeNode, TabItem, HighlightSpan, CommandItem,
         GridCol, GridCell, GridRow, GridSel, HistoryItem, SavedItem, Bridge } from "bridge.slint";
export { Theme } from "theme.slint";

export component MainWindow inherits Window {
    title: "Datara";
    icon: @image-url("../assets/icons/datara-128.png");
    preferred-width: 1100px;
    preferred-height: 700px;
    background: Theme.bg;

    /// Sidebar width, dragged by the 4px handle between sidebar and editor.
    /// Restored from `[workspace] sidebar_width` via Bridge.
    property<length> sidebar-width: Bridge.sidebar-width * 1px;

    init => {
        editor.focus-editor();
    }

    // Root command router: Ctrl+* shortcuts that the editor didn't consume
    // (or keys pressed while something else has focus) bubble up here.
    FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            Bridge.command(event.text, event.modifiers.control, event.modifiers.shift, event.modifiers.alt) ? accept : reject
        }

        VerticalLayout {
            spacing: 0;

            // Toolbar strip
            Rectangle {
                height: 40px;
                background: Theme.panel;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;

                    Text {
                        text: "Datara";
                        color: Theme.fg;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Run  (Ctrl+Enter)";
                        clicked => {
                            Bridge.command("\n", true, false, false);
                        }
                    }
                    if Bridge.query-running: Button {
                        text: "Stop";
                        clicked => {
                            Bridge.cancel-query();
                        }
                    }
                    Button {
                        text: "History";
                        clicked => {
                            Bridge.history-toggle();
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0;

                Rectangle {
                    width: root.sidebar-width;
                    clip: true;
                    Sidebar {
                        width: 100%;
                        height: 100%;
                        new-connection-requested => {
                            Bridge.conn-dialog-visible = true;
                        }
                    }
                }

                // 4px drag handle resizing the sidebar.
                Rectangle {
                    width: 4px;
                    background: resize-ta.has-hover || resize-ta.pressed ? Theme.accent : Theme.border;
                    resize-ta := TouchArea {
                        mouse-cursor: ew-resize;
                        property<length> start-w;
                        moved => {
                            if (self.pressed) {
                                root.sidebar-width = max(160px, min(480px, self.start-w + self.mouse-x - self.pressed-x));
                                Bridge.sidebar-width = root.sidebar-width / 1px;
                            }
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                self.start-w = root.sidebar-width;
                            }
                        }
                    }
                }

                panes := VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0;

                    TabStrip { }

                    editor := QueryEditor {
                        vertical-stretch: Bridge.editor-split;
                    }

                    // 4px drag handle splitting editor and result grid —
                    // the ratio persists as `[workspace] editor_split`.
                    Rectangle {
                        height: 4px;
                        background: split-ta.has-hover || split-ta.pressed ? Theme.accent : Theme.border;
                        split-ta := TouchArea {
                            mouse-cursor: ns-resize;
                            property<length> start-h;
                            moved => {
                                if (self.pressed) {
                                    Bridge.editor-split = max(0.15, min(0.85, (self.start-h + self.mouse-y - self.pressed-y) / panes.height));
                                }
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    self.start-h = Bridge.editor-split * panes.height;
                                }
                            }
                        }
                    }

                    // Result grid (Task 5.2).
                    ResultGrid {
                        vertical-stretch: 1 - Bridge.editor-split;
                    }
                    // Query-history bottom pane (Task 6.1) — sits between
                    // the result grid and the status bar.
                    if Bridge.history-visible: HistoryPanel {
                        // fixed height declared by the component
                    }
                    }
            }

            Rectangle { height: 1px; background: Theme.border; }

            // Status bar: status text left, caret position right.
            Rectangle {
                height: 22px;
                background: Theme.panel;

                Text {
                    x: 10px;
                    text: Bridge.status;
                    color: Theme.fg;
                    opacity: 0.7;
                    font-size: 11px;
                    vertical-alignment: center;
                    width: parent.width - 110px;
                    overflow: elide;
                }
                Text {
                    x: parent.width - 100px;
                    width: 90px;
                    text: Bridge.cursor-position;
                    color: Theme.fg;
                    opacity: 0.7;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }

    // Palette overlay — drawn above everything; closed state keeps no
    // instance so `init` re-focuses its LineEdit on every open.
    if Bridge.palette-visible: Palette {
        width: 100%;
        height: 100%;
    }

    // Command palette open state, mirrored so close returns focus to the
    // editor (the palette's LineEdit dies with it).
    property<bool> palette-open: Bridge.palette-visible;
    changed palette-open => {
        if (!palette-open) {
            editor.focus-editor();
        }
    }
    // Focus-back watcher: Escape in the panel writes history-visible
    // directly (no Rust round-trip) — closing returns focus to the editor.
    // Open-search lives in Rust (`history-toggle`); watchers aren't
    // reliable enough to own it.
    property<bool> history-open: Bridge.history-visible;
    changed history-open => {
        if (!history-open) {
            editor.focus-editor();
        }
    }

    // Modal overlay — Slint 1.18's fluent style has no Dialog widget, so a
    // dimmed full-window overlay with a centered card plays that role.
    if Bridge.conn-dialog-visible: ConnDialog {
        width: 100%;
        height: 100%;
        close-requested => {
            Bridge.conn-dialog-visible = false;
        }
    }

    // Ctrl+S "Save query" dialog — same overlay pattern as ConnDialog.
    if Bridge.save-dialog-visible: SaveQueryDialog {
        width: 100%;
        height: 100%;
        close-requested => {
            Bridge.save-dialog-visible = false;
        }
    }
}
