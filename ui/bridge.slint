/// Form fields for a new connection (Task 2.4).
export struct ConnForm {
    name: string,
    host: string,
    port: int,
    database: string,
    username: string,
    password: string,
    encryption: string, // "disabled" | "preferred" | "required"
    trust-cert: bool,
}


/// One visible row of the schema tree (Task 3.1). `kind` is
/// NodeKind::as_str: connection|database|folder-tables|folder-views|
/// table|view|column|loading.
export struct TreeNode {
    id: int,
    depth: int,
    kind: string,
    label: string,
    has-children: bool,
    expanded: bool,
}

/// One editor tab in the tab strip (Task 4.2). `id` is assigned by Rust's
/// `EditorState`; `title` is the rendered label.
export struct TabItem {
    id: int,
    title: string,
}

/// One syntax-highlight span, in *character cells* (not pixels): the editor
/// turns `line`/`col` into x/y with its measured monospace metrics so the
/// overlay stays aligned when the font size changes.
export struct HighlightSpan {
    text: string,
    color: color,
    line: int,
    col: int,
}

/// One row in the command palette (Task 4.5). `command` is the palette tag
/// `Bridge.palette-submit` hands to Rust — either a `PALETTE_COMMANDS` tag,
/// `connect`, or `open-connection:<tree-node-id>`.
export struct CommandItem {
    label: string,
    command: string,
}
/// One column header in the result grid (Task 5.2). `width` is pixels and
/// live-updates while a resize handle is dragged.
export struct GridCol {
    name: string,
    data-type: string,
    width: int,
}

/// One cell of a grid row: display text plus the NULL flag for styling.
export struct GridCell {
    text: string,
    is-null: bool,
}

/// One row of the result grid.
export struct GridRow {
    cells: [GridCell],
}

/// Rectangular cell selection in row/col indices (both ends inclusive).
export struct GridSel {
    r0: int,
    c0: int,
    r1: int,
    c1: int,
    active: bool,
}


/// Slint ↔ Tokio bridge. Callbacks fire on the UI thread and spawn work on
/// the Tokio runtime; `in` properties are pushed back via
/// `invoke_from_event_loop` (see bridge.rs). Grows in later tasks.
export global Bridge {
    callback new-connection(ConnForm);
    callback test-connection(ConnForm);
    /// Expand (lazy-load) or collapse a tree row.
    callback toggle-node(int);
    /// Double-click on a table/view row: resolve to preview SELECT (3.2).
    callback open-table(int);
    in property<[TreeNode]> tree;
    in property<string> status;
    in property<string> test-result;

    // ── Editor (Task 4.2) ────────────────────────────────────────────
    /// Editor buffer content. Pushed by Rust on tab switch / completion /
    /// preview; bound two-way to the editor's TextInput.
    in-out property<string> editor-text;
    /// Font size (pt) from `[editor] font_size` in config.toml.
    in property<int> editor-font-size;
    /// Line count of `editor-text` for the gutter.
    in property<int> line-count: 1;
    /// "Ln X, Col Y" for the status bar.
    in property<string> cursor-position;
    /// Highlight spans for the overlay layer, in char cells.
    in property<[HighlightSpan]> highlight-spans;
    /// One-shot cursor placement after a programmatic text change
    /// (completion apply, tab switch). The editor watches `changed` and
    /// calls `set-selection-offsets(v, v)`.
    in property<int> set-cursor;
    /// Ctrl+K toggles the schema filter LineEdit over the sidebar.
    in-out property<bool> schema-filter-visible;
    /// Filter string applied to the schema tree (the sidebar LineEdit's
    /// `edited` signal calls this on every keystroke). Empty restores the
    /// full tree.
    callback filter-tree(string);

    // ── Command palette (Task 4.5) ──────────────────────────────────
    in-out property<bool> palette-visible;
    /// Palette LineEdit text; two-way so Rust can reset it on open.
    in-out property<string> palette-query;
    /// Fuzzy-filtered rows for the palette ListView; Rust rebuilds on
    /// every `palette-edited`.
    in property<[CommandItem]> palette-items;
    /// Selected row — arrows in the palette LineEdit drive this.
    in-out property<int> palette-index;
    /// Palette query text changed; Rust refilters `palette-items`.
    callback palette-edited(string);
    /// Enter (or a row click): run `palette-items[palette-index].command`.
    callback palette-submit();
    /// Escape / click on the dim.
    callback palette-close();
    /// The "New connection" dialog. Rust sets it for the palette's
    /// "Connect…" item; Slint writes false on close.
    in-out property<bool> conn-dialog-visible;

    // ── Result grid (Task 5.2) ───────────────────────────────────────
    /// Column headers for the grid. Empty while no result is showing.
    in property<[GridCol]> columns;
    /// Result rows; ListView virtualizes over this model.
    in property<[GridRow]> rows;
    /// Total scrollable grid width in px (Σ column widths).
    in property<int> grid-w;
    /// Footer text: "N rows" / "N rows (truncated)" / "N rows affected" /
    /// the error message.
    in property<string> result-info;
    /// Current rectangular cell selection (for delegate highlighting).
    in property<GridSel> selection;
    /// Sorted column + direction for the header indicator (-1 = none).
    in property<int> sort-col: -1;
    in property<bool> sort-asc: true;
    /// Click on a cell: set the selection anchor.
    callback grid-select(row: int, col: int);
    /// Drag over the grid: extend the selection head. `row` is the delegate
    /// row + the mouse's row delta; `x` is the pointer's x within the row.
    callback grid-drag(row: int, x: length);
    /// Ctrl+C with the grid focused: copy the selection as TSV.
    callback copy-selection();
    /// Column resize handle moved by `delta` px since the last event.
    callback resize-column(idx: int, delta: length);
    /// Header clicked: toggle-sort that column.
    callback sort-column(idx: int);

    /// Current completion candidates; non-empty shows the popup.
    in property<[string]> completions;
    /// Selected row in the completion popup. In-out so the popup's own
    /// TouchArea can pick a row without a Rust round-trip.
    in-out property<int> completion-index;
    /// Text changed; `cursor` is the caret's UTF-8 byte offset at that
    /// moment (used for the completion prefix).
    callback editor-changed(text: string, cursor: int);
    /// Caret/selection moved. `line`/`col` are 1-based char coordinates.
    callback cursor-changed(cursor: int, anchor: int, line: int, col: int);
    /// Keyboard command router. Returns true when the key was consumed —
    /// used by the editor's `key-pressed` to decide `accept`/`reject`.
    callback command(text: string, ctrl: bool, shift: bool, alt: bool) -> bool;
    /// Popup keys: "accept" | "up" | "down" | "escape". Rust decides what
    /// to do (nothing when the popup is hidden).
    callback completion-action(string);

    // ── Execution (Task 4.3) ─────────────────────────────────────────
    /// Stop button: abort the query running on the active tab (or the only
    /// running query when the user switched tabs mid-flight).
    callback cancel-query();
    /// Any tab has a query in flight — shows the Stop button.
    in property<bool> query-running;
    // ── Tabs (Task 4.2) ─────────────────────────────────────────────
    in property<[TabItem]> tabs;
    in property<int> active-tab;
    callback new-tab();
    callback close-tab(id: int);
    callback switch-tab(id: int);
}
